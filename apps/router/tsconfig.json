{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "tsBuildInfoFile": "../../node_modules/.cache/tsbuildinfo/router-app",
    "jsx": "react-jsx"
  },
  "include": ["src", "env.d.ts", "../home/src/entry.tsx"],
  "exclude": [
    "dist",
    "build",
    "node_modules",

    // keep ESLint config out of this project's TS program
    "../../eslint.config.*",
    "../../packages/eslint-config/**",

    // Node/Vite configs live in tsconfig.node.json
    "vite.config.ts",
    "vitest.config.ts",
    "postcss.config.ts",
    "tailwind.config.ts",
    "scripts"
  ]
}
