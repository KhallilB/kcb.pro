{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true, // Vite handles builds
    "rootDir": ".", // okay; just used for project structure checks
    "tsBuildInfoFile": "../../node_modules/.cache/tsbuildinfo/router-app",
    "jsx": "react-jsx",

    // Keep baseUrl at repo root so @packages/* remains correct.
    // Add an app-local alias without breaking the inherited one.
    "paths": {
      "@/*": ["./src/*"]
    },

    "types": ["vite/client"]
  },
  "include": ["src", "env.d.ts"],
  "exclude": [
    "dist",
    "build",
    "node_modules",

    // keep ESLint config out of this project's TS program
    "../../eslint.config.*",
    "../../packages/eslint-config/**",

    // Node/Vite configs live in tsconfig.node.json
    "vite.config.ts",
    "vitest.config.ts",
    "postcss.config.ts",
    "tailwind.config.ts",
    "scripts"
  ]
}
