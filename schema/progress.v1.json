{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/KhallilB/kcb.pro/main/schema/progress.v1.json",
  "title": "kcb.pro progress file, version 1",
  "description": "progress.json at a project's repository root. Entries are append-only and sorted by date, oldest first. kcb.pro also checks that ids are unique, that no date is after the build day, that project equals the kcb.pro slug, and that dates are real calendar days. Unknown extra fields are allowed and ignored.",
  "type": "object",
  "required": ["schema", "project", "entries"],
  "properties": {
    "schema": { "const": 1 },
    "project": { "$ref": "#/definitions/text" },
    "entries": { "type": "array", "items": { "$ref": "#/definitions/entry" } }
  },
  "definitions": {
    "text": { "type": "string", "pattern": "\\S" },
    "entry": {
      "type": "object",
      "required": [
        "id",
        "subject",
        "date",
        "kind",
        "title",
        "result",
        "measured",
        "evidence"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^\\S+$" },
        "subject": {
          "description": "Entries about the same thing over time share a subject.",
          "type": "string",
          "pattern": "\\S"
        },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "kind": { "enum": ["experiment", "tests", "release", "milestone"] },
        "title": { "$ref": "#/definitions/text" },
        "passMark": {
          "description": "What counted as success, decided before the result; required for experiment and tests.",
          "type": "string",
          "pattern": "\\S"
        },
        "result": { "enum": ["pass", "partial", "fail", "not-run"] },
        "summary": {
          "description": "One line on what works and what is left: 1 to 140 characters once trimmed, no line breaks. Required when result is partial.",
          "type": "string",
          "pattern": "^[^\\S\\n\\r]*\\S(?:[^\\n\\r]{0,138}\\S)?[^\\S\\n\\r]*$"
        },
        "measured": {
          "description": "What was measured, as label and value pairs; may be empty.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "value"],
            "properties": {
              "label": { "$ref": "#/definitions/text" },
              "value": { "$ref": "#/definitions/text" }
            }
          }
        },
        "evidence": {
          "description": "Links that back the result; a path is relative to the repository root at commit, a url must be https. Required unless the result is not-run.",
          "type": "array",
          "items": { "$ref": "#/definitions/evidence" }
        },
        "commit": {
          "description": "Commit hash that recorded the evidence; required when any evidence uses a path.",
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "result": { "const": "partial" } } },
          "then": { "required": ["summary"] }
        },
        {
          "if": {
            "properties": { "kind": { "enum": ["experiment", "tests"] } }
          },
          "then": { "required": ["passMark"] }
        },
        {
          "if": {
            "properties": { "result": { "not": { "const": "not-run" } } }
          },
          "then": {
            "properties": { "evidence": { "type": "array", "minItems": 1 } }
          }
        },
        {
          "if": {
            "properties": {
              "evidence": {
                "type": "array",
                "contains": { "type": "object", "required": ["path"] }
              }
            }
          },
          "then": { "required": ["commit"] }
        }
      ]
    },
    "evidence": {
      "oneOf": [
        {
          "type": "object",
          "required": ["label", "path"],
          "not": { "required": ["url"] },
          "properties": {
            "label": { "$ref": "#/definitions/text" },
            "path": {
              "type": "string",
              "allOf": [
                { "$ref": "#/definitions/text" },
                { "not": { "pattern": "^/" } },
                { "not": { "pattern": "(^|/)\\.\\.(/|$)" } }
              ]
            }
          }
        },
        {
          "type": "object",
          "required": ["label", "url"],
          "not": { "required": ["path"] },
          "properties": {
            "label": { "$ref": "#/definitions/text" },
            "url": { "type": "string", "pattern": "^https://\\S+$" }
          }
        }
      ]
    }
  }
}
