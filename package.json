{
  "name": "kcb.pro",
  "version": "0.1.0",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "//************* DEVELOPMENT *************//": "",
    "dev:router": "bun --cwd apps/router dev",
    "dev:home": "bun --cwd apps/home dev",
    "//************* BUILD *************//": "",
    "build:router": "bun --cwd apps/router build",
    "build:home": "bun --cwd apps/home build",
    "//************* LINT & TYPECHECK *************//": "",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "typecheck": "tsc --noEmit",
    "typecheck:home": "bun --cwd apps/home run typecheck",
    "typecheck:router": "bun --cwd apps/router run typecheck",
    "//************* TEST *************//": "",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:home": "bun --cwd apps/home test",
    "test:router": "bun --cwd apps/router test",
    "//************* RELEASE *************//": "",
    "release:router": "cd apps/router && release-it",
    "release:home": "cd apps/home && release-it",
    "release:styles": "cd libs/styles && release-it",
    "release:router:dry": "cd apps/router && release-it --dry-run",
    "release:home:dry": "cd apps/home && release-it --dry-run",
    "release:styles:dry": "cd libs/styles && release-it --dry-run",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.7.1",
    "tailwindcss": "^4.1.11"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.32.0",
    "@release-it/bumper": "^7.0.5",
    "@release-it/conventional-changelog": "^10.0.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^24.2.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "@vitest/ui": "^2.1.8",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "jiti": "^2.5.1",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.1.4",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "release-it": "^19.0.4",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.6",
    "vitest": "^2.1.8",
    "vitest-browser-react": "^1.0.1"
  }
}
