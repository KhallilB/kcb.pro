{
  "name": "kcb.pro",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr app/entry-server.tsx --outDir build-ssr && bun scripts/prerender.ts",
    "preview": "bun scripts/serve-build.ts",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.config.ts integration",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "check": "bun run lint && bun run build && bun run test && bun run test:integration && bun run test:e2e",
    "deploy": "wrangler pages deploy ./build --project-name kcb-pro"
  },
  "dependencies": {
    "@fontsource/cinzel": "5",
    "@fontsource/eb-garamond": "5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "^7.13.1",
    "three": "0.128.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "eslint": "^9.39.3",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.8.1",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^6.4.1",
    "vitest": "^3.2.4",
    "wrangler": "4.151.3"
  },
  "packageManager": "bun@1.3.11"
}
